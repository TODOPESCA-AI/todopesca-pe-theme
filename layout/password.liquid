<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:'Inter',sans-serif;background:{{ settings.color_text }};color:#fff;min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:24px}
    .logo{font-family:'Anton';text-transform:uppercase;font-size:clamp(2.4rem,9vw,5rem);letter-spacing:.02em}
    p{opacity:.6;margin:14px 0 26px;font-family:'Oswald';text-transform:uppercase;letter-spacing:.1em;font-size:.9rem}
    form{display:flex;max-width:380px;margin:0 auto;border:1px solid #333}
    input{flex:1;background:transparent;border:0;color:#fff;padding:14px 18px;outline:none}
    button{background:#fff;color:#000;border:0;padding:0 24px;font-family:'Oswald';text-transform:uppercase;font-weight:600;cursor:pointer}
    .err{color:#ff6b6b;font-family:'Inter';margin-top:10px;font-size:.85rem;letter-spacing:0}
  </style>
</head>
<body>
  <main>
    {{ content_for_layout }}
  </main>
</body>
</html>