{%- comment -%} Página de contraseña (próximamente) {%- endcomment -%}
{% layout 'password' %}
<div class="logo">{{ shop.name }}</div>
<p>Próximamente</p>
{%- form 'storefront_password' -%}
  <input type="password" name="password" placeholder="Contraseña de la tienda" required>
  <button type="submit">Entrar</button>
  {%- if form.errors -%}<div class="err">{{ form.errors.translated_fields.password }} {{ form.errors.messages.password }}</div>{%- endif -%}
{%- endform -%}