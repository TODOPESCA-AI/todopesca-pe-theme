{%- comment -%} Página estándar {%- endcomment -%}
<section class="sec" style="padding-top:clamp(40px,6vw,80px)">
  <div class="wrap" style="max-width:820px">
    <div class="sec-head reveal" style="display:block"><h1 class="display">{{ page.title }}</h1></div>
    <div class="rte reveal">{{ page.content }}</div>
  </div>
</section>
<style>.rte{line-height:1.7;color:#333;font-size:1.02rem}.rte h2{font-family:'Oswald';text-transform:uppercase;margin:28px 0 12px}.rte p{margin-bottom:16px}.rte img{margin:18px 0}</style>