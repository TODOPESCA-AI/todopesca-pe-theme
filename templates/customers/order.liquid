{%- comment -%} Detalle de pedido {%- endcomment -%}
<section class="sec" style="padding-top:clamp(40px,6vw,80px)">
  <div class="wrap">
    <div class="sec-head" style="display:block"><h1 class="display">Pedido {{ order.name }}</h1><p style="color:var(--grey);margin-top:8px">{{ order.created_at | date: '%d de %B, %Y' }}</p></div>
    <table class="acct-table" style="width:100%;border-collapse:collapse;margin-top:20px">
      <thead><tr><th style="text-align:left">Producto</th><th>Cantidad</th><th style="text-align:right">Precio</th></tr></thead>
      <tbody>
        {%- for line in order.line_items -%}
          <tr><td>{{ line.title }}</td><td style="text-align:center">{{ line.quantity }}</td><td style="text-align:right">{{ line.final_line_price | money }}</td></tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr><td colspan="2" style="text-align:right">Subtotal</td><td style="text-align:right">{{ order.line_items_subtotal_price | money }}</td></tr>
        <tr><td colspan="2" style="text-align:right">Envío</td><td style="text-align:right">{{ order.shipping_price | money }}</td></tr>
        <tr><td colspan="2" style="text-align:right;font-weight:700">Total</td><td style="text-align:right;font-weight:700">{{ order.total_price | money }}</td></tr>
      </tfoot>
    </table>
  </div>
</section>
<style>.acct-table th{font-family:'Oswald';text-transform:uppercase;font-size:.74rem;border-bottom:1.5px solid var(--black);padding:10px 8px}.acct-table td{padding:12px 8px;border-bottom:1px solid var(--line)}.acct-table tfoot td{border-bottom:0;font-family:'Oswald'}</style>