{%- comment -%} Login {%- endcomment -%}
<section class="sec" style="padding-top:clamp(40px,6vw,80px)">
  <div class="wrap" style="max-width:460px">
    <div class="sec-head" style="display:block"><h1 class="display">Ingresar</h1></div>
    {%- form 'customer_login' -%}
      {{ form.errors | default_errors }}
      <label class="flbl">Email</label>
      <input type="email" name="customer[email]" class="finp" required>
      <label class="flbl">Contraseña</label>
      <input type="password" name="customer[password]" class="finp" required>
      <button type="submit" class="btn" style="width:100%;justify-content:center;margin-top:8px">Ingresar</button>
    {%- endform -%}
    <p class="fmeta"><a href="{{ routes.account_register_url }}">Crear cuenta</a> · <a href="#" onclick="document.getElementById('recover').style.display='block';return false">¿Olvidaste tu contraseña?</a></p>
    <div id="recover" style="display:none;margin-top:20px">
      {%- form 'recover_customer_password' -%}
        {{ form.errors | default_errors }}
        {%- if form.posted_successfully? -%}<p>Te enviamos un correo para restablecerla.</p>{%- endif -%}
        <label class="flbl">Email de recuperación</label>
        <input type="email" name="email" class="finp">
        <button type="submit" class="btn outline" style="width:100%;justify-content:center">Enviar</button>
      {%- endform -%}
    </div>
  </div>
</section>
<style>
.flbl{display:block;font-family:'Oswald';text-transform:uppercase;font-size:.74rem;letter-spacing:.08em;margin:14px 0 6px}
.finp{width:100%;padding:13px 16px;border:1.5px solid var(--black);font-size:1rem}
.fmeta{margin-top:16px;font-size:.88rem;color:var(--grey)}
.fmeta a{text-decoration:underline}
</style>