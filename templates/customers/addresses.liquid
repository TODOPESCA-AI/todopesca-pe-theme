{%- comment -%} Direcciones {%- endcomment -%}
<section class="sec" style="padding-top:clamp(40px,6vw,80px)">
  <div class="wrap" style="max-width:640px">
    <div class="sec-head"><h1 class="display">Direcciones</h1><a href="{{ routes.account_url }}">Volver</a></div>
    {%- paginate customer.addresses by 5 -%}
      {%- for address in customer.addresses -%}
        <div style="border:1px solid var(--line);padding:18px;margin-bottom:14px">
          <p style="line-height:1.6">{{ address | format_address }}</p>
        </div>
      {%- endfor -%}
    {%- endpaginate -%}
    <details style="margin-top:20px">
      <summary class="btn" style="cursor:pointer">Agregar dirección</summary>
      {%- form 'customer_address', customer.new_address -%}
        {{ form.errors | default_errors }}
        <label class="flbl">Nombre</label><input class="finp" name="address[first_name]">
        <label class="flbl">Apellido</label><input class="finp" name="address[last_name]">
        <label class="flbl">Dirección</label><input class="finp" name="address[address1]">
        <label class="flbl">Ciudad</label><input class="finp" name="address[city]">
        <label class="flbl">País</label><input class="finp" name="address[country]">
        <label class="flbl">Teléfono</label><input class="finp" name="address[phone]">
        <button type="submit" class="btn" style="margin-top:12px">Guardar</button>
      {%- endform -%}
    </details>
  </div>
</section>
<style>.flbl{display:block;font-family:'Oswald';text-transform:uppercase;font-size:.74rem;letter-spacing:.08em;margin:12px 0 6px}.finp{width:100%;padding:12px 16px;border:1.5px solid var(--black)}</style>