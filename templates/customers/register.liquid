{%- comment -%} Registro {%- endcomment -%}
<section class="sec" style="padding-top:clamp(40px,6vw,80px)">
  <div class="wrap" style="max-width:460px">
    <div class="sec-head" style="display:block"><h1 class="display">Crear cuenta</h1></div>
    {%- form 'create_customer' -%}
      {{ form.errors | default_errors }}
      <label class="flbl">Nombre</label><input type="text" name="customer[first_name]" class="finp">
      <label class="flbl">Apellido</label><input type="text" name="customer[last_name]" class="finp">
      <label class="flbl">Email</label><input type="email" name="customer[email]" class="finp" required>
      <label class="flbl">Contraseña</label><input type="password" name="customer[password]" class="finp" required>
      <button type="submit" class="btn" style="width:100%;justify-content:center;margin-top:10px">Crear cuenta</button>
    {%- endform -%}
    <p class="fmeta"><a href="{{ routes.account_login_url }}">Ya tengo cuenta</a></p>
  </div>
</section>
<style>.flbl{display:block;font-family:'Oswald';text-transform:uppercase;font-size:.74rem;letter-spacing:.08em;margin:14px 0 6px}.finp{width:100%;padding:13px 16px;border:1.5px solid var(--black);font-size:1rem}.fmeta{margin-top:16px;font-size:.88rem}.fmeta a{text-decoration:underline}</style>