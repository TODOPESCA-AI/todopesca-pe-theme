{%- comment -%} Activar cuenta {%- endcomment -%}
<section class="sec" style="padding-top:clamp(40px,6vw,80px)">
  <div class="wrap" style="max-width:440px">
    <div class="sec-head" style="display:block"><h1 class="display">Activar cuenta</h1></div>
    {%- form 'activate_customer_password' -%}
      {{ form.errors | default_errors }}
      <label class="flbl">Contraseña</label><input type="password" name="customer[password]" class="finp" required>
      <label class="flbl">Confirmar</label><input type="password" name="customer[password_confirmation]" class="finp" required>
      <button type="submit" class="btn" style="width:100%;justify-content:center;margin-top:10px">Activar</button>
      <button type="submit" name="decline" class="btn outline" style="width:100%;justify-content:center;margin-top:10px">Rechazar invitación</button>
    {%- endform -%}
  </div>
</section>
<style>.flbl{display:block;font-family:'Oswald';text-transform:uppercase;font-size:.74rem;letter-spacing:.08em;margin:12px 0 6px}.finp{width:100%;padding:13px 16px;border:1.5px solid var(--black)}</style>