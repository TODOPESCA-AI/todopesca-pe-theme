{%- comment -%} Artículo {%- endcomment -%}
<section class="sec" style="padding-top:clamp(40px,6vw,80px)">
  <div class="wrap" style="max-width:780px">
    <div class="reveal" style="margin-bottom:24px">
      <div class="bmeta">{{ article.published_at | date: '%d %b, %Y' }}{% if article.author != blank %} · {{ article.author }}{% endif %}</div>
      <h1 class="display" style="font-size:clamp(2rem,6vw,3.4rem);margin-top:10px">{{ article.title }}</h1>
    </div>
    {%- if article.image -%}<div class="aimg reveal"><img src="{{ article.image | image_url: width: 1400 }}" alt="{{ article.title }}"></div>{%- endif -%}
    <div class="rte reveal">{{ article.content }}</div>
  </div>
</section>
<style>
.bmeta{font-family:'Oswald';text-transform:uppercase;font-size:.74rem;letter-spacing:.1em;color:var(--grey)}
.aimg{aspect-ratio:16/9;overflow:hidden;background:var(--g1);margin-bottom:28px}
.aimg img{width:100%;height:100%;object-fit:cover}
.rte{line-height:1.8;color:#333;font-size:1.05rem}.rte h2{font-family:'Oswald';text-transform:uppercase;margin:28px 0 12px}.rte p{margin-bottom:18px}.rte img{margin:18px 0}
</style>