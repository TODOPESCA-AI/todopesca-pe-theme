{%- comment -%} Productos destacados (fondo atmosférico) {%- endcomment -%}
<section class="sec feat-dark">
  {%- if section.settings.video_mp4 != blank -%}
    <video class="feat-bg" autoplay muted loop playsinline preload="metadata" src="{{ section.settings.video_mp4 }}"></video>
  {%- elsif section.settings.bg_image != blank -%}
    <img class="feat-bg" src="{% render 'cdn-w', u: section.settings.bg_image, w: 1800 %}" alt="" loading="lazy" decoding="async">
  {%- endif -%}
  {%- if section.settings.watermark != blank -%}<div class="wm light" data-px="0.14">{{ section.settings.watermark }}</div>{%- endif -%}
  <div class="wrap">
    <div class="sec-head reveal">
      <h2 class="display">{{ section.settings.title }}</h2>
      {%- if section.settings.link_label != blank -%}<a href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <div class="grid3 reveal">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- assign _pt = '' -%}
        {%- if p != blank -%}{%- assign _pt = p.tags | join: ',' | downcase -%}{%- endif -%}
        <a class="pcard" href="{% if p != blank %}{{ p.url }}{% else %}{{ block.settings.link }}{% endif %}" {{ block.shopify_attributes }}>
          <div class="ph">
            {%- if block.settings.tag != blank -%}<span class="tag">{{ block.settings.tag }}</span>{%- endif -%}
            {%- if p != blank and p.featured_image -%}
              <img src="{{ p.featured_image | image_url: width: 800 }}" alt="{{ p.title | escape }}" width="{{ p.featured_image.width }}" height="{{ p.featured_image.height }}" loading="lazy" decoding="async" style="object-fit:contain;padding:7%">
            {%- elsif block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" loading="lazy" decoding="async" style="object-fit:contain;padding:7%">
            {%- endif -%}
          </div>
          {%- if block.settings.kicker != blank -%}<div class="k">{{ block.settings.kicker }}</div>{%- endif -%}
          <h3>{% if p != blank %}{{ p.title }}{% else %}{{ block.settings.title }}{% endif %}</h3>
          {%- if p != blank -%}
            <div class="price">
              {%- if _pt contains 'ocultar-precio' -%}
                <span class="consultar-precio">Consultar precio</span>
              {%- else -%}
                {%- if p.compare_at_price > p.price -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}
                {%- if p.price_varies -%}Desde {% endif %}{{ p.price | money }}
              {%- endif -%}
            </div>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
.feat-dark{position:relative;overflow:hidden;background:#0b0b0b;color:#fff}
.feat-dark .feat-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.72;z-index:0}
.feat-dark::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,8,8,.5) 0%,rgba(8,8,8,.18) 42%,rgba(8,8,8,.42) 100%);z-index:1;pointer-events:none}
.feat-dark .wrap{position:relative;z-index:2}
.feat-dark .sec-head h2{color:#fff;text-shadow:0 2px 22px rgba(0,0,0,.65)}
.feat-dark .sec-head a{color:#fff;border-color:#fff;text-shadow:0 1px 10px rgba(0,0,0,.6)}
.feat-dark .pcard h3{color:#fff;text-shadow:0 1px 10px rgba(0,0,0,.5)}
.feat-dark .pcard .price{color:#fff;text-shadow:0 1px 10px rgba(0,0,0,.5)}
.feat-dark .pcard .k{color:rgba(255,255,255,.85);text-shadow:0 1px 8px rgba(0,0,0,.5)}
.feat-dark .pcard .ph{background:#fff}
.feat-dark .wm.light{color:rgba(255,255,255,.06)}
</style>

{% schema %}
{
  "name": "Productos destacados",
  "settings": [
    { "type": "text", "id": "title", "label": "Titulo", "default": "Lo mas buscado" },
    { "type": "text", "id": "link_label", "label": "Enlace texto", "default": "Bestsellers" },
    { "type": "url", "id": "link_url", "label": "Enlace destino" },
    { "type": "text", "id": "bg_image", "label": "Imagen de fondo (URL)" },
    { "type": "text", "id": "video_mp4", "label": "Video de fondo MP4 (URL, opcional)" },
    { "type": "text", "id": "watermark", "label": "Marca de agua" }
  ],
  "blocks": [
    {
      "type": "producto",
      "name": "Producto",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto del catalogo" },
        { "type": "text", "id": "kicker", "label": "Etiqueta superior", "default": "Surfcasting" },
        { "type": "text", "id": "tag", "label": "Insignia (esquina)" },
        { "type": "text", "id": "title", "label": "Titulo manual", "default": "Beach Walker" },
        { "type": "image_picker", "id": "image", "label": "Imagen manual" },
        { "type": "url", "id": "link", "label": "Enlace manual" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Productos destacados",
      "blocks": [
        { "type": "producto", "settings": { "kicker": "Surfcasting", "title": "Beach Walker" } },
        { "type": "producto", "settings": { "kicker": "Jerkbait", "title": "Realis 120SP" } },
        { "type": "producto", "settings": { "kicker": "Minnow", "title": "Tide Minnow" } }
      ]
    }
  ]
}
{% endschema %}
